# Copy to .env.local and fill in. NEXT_PUBLIC_ vars are safe to expose to
# the browser (the anon/publishable key is protected by RLS) — never put
# secret keys (the Anthropic key) here; those live server-side as Supabase
# Edge Function secrets, same as the native app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
